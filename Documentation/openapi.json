{
  "openapi": "3.1.0",
  "info": {
    "title": "EqualCare LAN API",
    "version": "1.0.0",
    "description": "One patient, one ESP32, one staff dashboard. Single backend process. API prefix /api/v1. Browser roles use session cookies; one cookie can hold both roles, so browser calls send X-EqualCare-Role (patient or staff; optional when only one role is signed in). Writes also require that role's CSRF token. Logout ends only the named role. No CORS: serve frontend from backend origin or use a development proxy."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check backend and request storage",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/session": {
      "post": {
        "summary": "Sign in as patient or staff",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "patient",
                      "staff"
                    ]
                  },
                  "password": {
                    "type": "string"
                  },
                  "login_id": {
                    "type": "string",
                    "description": "Required for staff; default staff login ID is staff. Omit for patient."
                  }
                },
                "required": [
                  "role",
                  "password"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "role": {
                          "const": "staff"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "login_id"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-EqualCare-Client",
            "required": true,
            "schema": {
              "const": "dashboard"
            }
          }
        ],
        "description": "Patient: role + password. Staff: role + login_id + password. Cookie survives reloads during this backend run; backend restart invalidates it."
      },
      "get": {
        "summary": "Get current session and CSRF token",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "summary": "Sign out and release input lease",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/heartbeat": {
      "post": {
        "summary": "Firmware heartbeat every five seconds",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  }
                },
                "required": [
                  "device_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/device": {
      "get": {
        "summary": "Read device connectivity; patient or staff",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "device_id": {
                      "type": "string"
                    },
                    "connected": {
                      "type": "boolean"
                    },
                    "seconds_since_seen": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "device_id",
                    "connected",
                    "seconds_since_seen"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/input-events": {
      "post": {
        "summary": "Firmware sends one classified action",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InputEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean"
                    },
                    "cursor": {
                      "type": "integer"
                    },
                    "reason": {
                      "enum": [
                        "duplicate_or_out_of_order",
                        "retired_boot"
                      ]
                    }
                  },
                  "required": [
                    "accepted"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "summary": "Patient only: acquire/renew sole consumer lease and poll commands",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/InputEvent"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "cursor": {
                                "type": "integer"
                              }
                            },
                            "required": [
                              "cursor"
                            ]
                          }
                        ]
                      }
                    },
                    "cursor": {
                      "type": "integer"
                    },
                    "epoch": {
                      "type": "string"
                    },
                    "reset": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "events",
                    "cursor",
                    "epoch",
                    "reset"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Consumer-ID",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "description": "Random unique page-instance ID; never share across tabs."
          },
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Omit on load/reconnect to synchronize without replay."
          },
          {
            "in": "query",
            "name": "epoch",
            "schema": {
              "type": "string"
            },
            "description": "Echo previous response epoch with after."
          }
        ],
        "description": "Poll every 250 ms without overlapping calls. Events expire after two seconds. Lease lasts three seconds. A second consumer receives 409 CONSUMER_BUSY. reset=true returns no events; accept the new cursor. Buffer holds 128 events."
      }
    },
    "/requests": {
      "get": {
        "summary": "Patient or staff: list durable requests oldest first",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Request"
                      }
                    },
                    "patient": {
                      "$ref": "#/components/schemas/Patient"
                    }
                  },
                  "required": [
                    "requests",
                    "patient"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "summary": "Patient only: submit or safely retry assistance request",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "$ref": "#/components/schemas/RequestType"
                  },
                  "idempotency_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  }
                },
                "required": [
                  "type",
                  "idempotency_key"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing request for key or active type",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "$ref": "#/components/schemas/Request"
                    }
                  },
                  "required": [
                    "request"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "$ref": "#/components/schemas/Request"
                    }
                  },
                  "required": [
                    "request"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Keep the same key for an uncertain delivery. Reusing a key with another type returns 409. Different keys for the same active type alias to the existing request."
      }
    },
    "/requests/{id}/acknowledge": {
      "post": {
        "summary": "Staff only: acknowledge request",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "$ref": "#/components/schemas/Request"
                    }
                  },
                  "required": [
                    "request"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "PENDING becomes ACKNOWLEDGED. Already acknowledged/resolved requests remain unchanged."
      }
    },
    "/requests/{id}/resolve": {
      "post": {
        "summary": "Staff only: resolve request",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "$ref": "#/components/schemas/Request"
                    }
                  },
                  "required": [
                    "request"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Requires ACKNOWLEDGED; PENDING returns 409. Repeated resolution is harmless."
      }
    },
    "/calibration": {
      "post": {
        "summary": "Start an eye calibration or eye test; patient",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "calibrate",
                      "test"
                    ],
                    "default": "calibrate"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/CalibrationJob"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "job"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "DEVICE_OFFLINE (no heartbeat) or CALIBRATION_BUSY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "summary": "The current calibration job (null if none); patient",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/CalibrationJob"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "job"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "summary": "Cancel the running calibration job; patient",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/CalibrationJob"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "job"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/calibration/device": {
      "get": {
        "summary": "Poll for a calibration job to run (id, mode, state); device. Counts as a heartbeat.",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/CalibrationJob"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "job"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "put": {
        "summary": "Report progress or the result of the current job; device",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/CalibrationJob"
                  }
                ],
                "description": "id and state (running, fitting, done or failed) plus any CalibrationJob fields; others are ignored. A report for a cancelled or finished job changes nothing."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/CalibrationJob"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "job"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "INVALID_STATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "STALE_JOB: not the current job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "RequestType": {
        "type": "string",
        "enum": [
          "WATER",
          "TOILET_ASSISTANCE",
          "REPOSITIONING",
          "CALL_NURSE"
        ]
      },
      "Command": {
        "type": "string",
        "enum": [
          "NEXT",
          "PREVIOUS",
          "SELECT"
        ]
      },
      "InputEvent": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "enum": [
              "esp32-01"
            ],
            "description": "Configured device ID; deployment may override."
          },
          "boot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "source": {
            "type": "string",
            "enum": [
              "joystick",
              "eog"
            ]
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          }
        },
        "required": [
          "device_id",
          "boot_id",
          "seq",
          "source",
          "command"
        ]
      },
      "Request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/RequestType"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACKNOWLEDGED",
              "RESOLVED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "acknowledged_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "created_at",
          "updated_at",
          "acknowledged_at",
          "resolved_at"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "patient",
              "staff"
            ]
          },
          "csrf": {
            "type": "string"
          },
          "patient": {
            "$ref": "#/components/schemas/Patient"
          }
        },
        "required": [
          "role",
          "csrf",
          "patient"
        ]
      },
      "Patient": {
        "type": "object",
        "properties": {
          "id": {
            "const": "default"
          },
          "name": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "device_id"
        ]
      },
      "CalibrationJob": {
        "type": "object",
        "description": "An eye calibration ('calibrate') or eye test ('test') the patient screen asked for. The acquisition process runs it and reports progress; a request not taken up within 10 s, or a running job silent for 30 s, becomes failed.",
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "calibrate",
              "test"
            ]
          },
          "state": {
            "enum": [
              "requested",
              "running",
              "fitting",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "label": {
            "type": "string",
            "description": "Current cue: CENTER, REST, LEFT, RIGHT, BLINK, DOUBLE_BLINK or NATURAL"
          },
          "cue": {
            "type": "string"
          },
          "round": {
            "type": "integer"
          },
          "rounds": {
            "type": "integer"
          },
          "step": {
            "type": "integer"
          },
          "steps": {
            "type": "integer"
          },
          "seconds": {
            "type": "number"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "signals": {
            "type": "array",
            "description": "Test mode: the latest eye signals seen",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "LEFT",
                    "RIGHT",
                    "BLINK",
                    "DOUBLE_BLINK"
                  ]
                },
                "at": {
                  "type": "number"
                }
              }
            }
          },
          "result": {
            "type": "object",
            "description": "Calibrate mode, when done: passed, flipped[] ('left/right', 'blink'), saved, shortfalls[], metrics{looks, look_hits, wrong_direction, double_blinks, select_hits, false_moves, false_selects, minutes}"
          },
          "message": {
            "type": "string",
            "description": "Why it failed"
          }
        },
        "required": [
          "id",
          "mode",
          "state"
        ]
      }
    },
    "securitySchemes": {
